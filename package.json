{
  "name": "memewatch",
  "version": "1.0.0",
  "description": "Solana memecoin watchlist bot - gates, scoring, state machine, live dashboard",
  "main": "dist/boot.js",
  "scripts": {
    "build": "tsc",
    "test": "node --test $(find dist -name '*.test.js' ! -name '*.integration.test.js' -print)",
    "test:integration": "node --test $(find dist -name '*.integration.test.js' -print)",
    "check": "npm run build && npm test",
    "start": "node --require ./dist/discovery-capacity.js --require ./dist/helius-free-budget.js --require ./dist/helius-quota-guard.js --require ./dist/ingest/pumpportal-guard.js dist/boot.js",
    "dev": "tsx --require ./src/discovery-capacity.ts src/boot.ts"
  },
  "engines": { "node": ">=20 <25" },
  "dependencies": {
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
